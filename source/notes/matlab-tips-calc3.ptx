<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="matlab-multivariable-calculus">
    <title>MATLAB Tips for Multivariable Calculus</title>

    <p>
        This page summarizes MATLAB commands commonly used in
        multivariable calculus. Use these examples as templates and
        modify them for your own problems.
    </p>

    <subsection xml:id="creating-grids">
        <title>Creating a Grid</title>

        <p>
            Most surface plots require a mesh of points.
        </p>

<cd>
[x,y] = meshgrid(-2:0.1:2,-2:0.1:2);
</cd>

        <p>
            MATLAB creates matrices containing all combinations of
            <m>x</m> and <m>y</m> values.
        </p>
    </subsection>

    <subsection xml:id="surface-plots">
        <title>Surface Plots</title>

<cd>
[x,y] = meshgrid(-2:0.1:2,-2:0.1:2);

z = x.^2 + y.^2;

surf(x,y,z)
</cd>

        <p>
            Useful commands:
        </p>

<cd>
shading interp
colorbar
xlabel('x')
ylabel('y')
zlabel('z')
title('Surface Plot')
</cd>

        <p>
            Alternative surface displays:
        </p>

<cd>
mesh(x,y,z)
surfc(x,y,z)
</cd>

    </subsection>

    <subsection xml:id="contour-plots">
        <title>Contour Plots</title>

<cd>
[x,y] = meshgrid(-2:0.05:2,-2:0.05:2);

z = x.^2 - y.^2;

contour(x,y,z)
</cd>

        <p>
            Specify the number of contour levels:
        </p>

<cd>
contour(x,y,z,20)
</cd>

        <p>
            Filled contour plot:
        </p>

<cd>
contourf(x,y,z)
colorbar
</cd>

    </subsection>

    <subsection xml:id="symbolic-partials">
        <title>Partial Derivatives</title>

<cd>
syms x y

f = x^2*y + sin(x*y);

fx = diff(f,x)
fy = diff(f,y)
</cd>

        <p>
            Second derivatives:
        </p>

<cd>
fxx = diff(f,x,2)
fyy = diff(f,y,2)
fxy = diff(diff(f,x),y)
</cd>

    </subsection>

    <subsection xml:id="gradient">
        <title>Gradient</title>

<cd>
syms x y

f = x^2*y + sin(x*y);

gradf = gradient(f,[x y])
</cd>

        <p>
            Evaluate the gradient at a point:
        </p>

<cd>
subs(gradf,[x y],[1 2])
</cd>

    </subsection>

    <subsection xml:id="tangent-plane">
        <title>Tangent Plane</title>

<cd>
syms x y

f = x^2 + y^2;

fx = diff(f,x);
fy = diff(f,y);

a = 1;
b = 2;

T = subs(f,[x y],[a b]) ...
    + subs(fx,[x y],[a b])*(x-a) ...
    + subs(fy,[x y],[a b])*(y-b);
</cd>

        <p>
            The variable <c>T</c> stores the tangent plane approximation.
        </p>

    </subsection>

    <subsection>
        <title>Space Curves</title>

<cd>
t = linspace(0,4*pi,500);

x = cos(t);
y = sin(t);
z = t;

plot3(x,y,z,'LineWidth',2)
grid on
</cd>

        <p>
            Common commands:
        </p>

<cd>
axis equal
view(45,30)
</cd>

    </subsection>

    <subsection xml:id="vector-fields">
        <title>Vector Fields</title>

<cd>
[x,y] = meshgrid(-2:0.3:2,-2:0.3:2);

u = y;
v = -x;

quiver(x,y,u,v)
axis equal
</cd>

        <p>
            The command <c>quiver</c> draws vectors.
        </p>

    </subsection>

    <subsection xml:id="vector-fields-3d">
        <title>Three-Dimensional Vector Fields</title>

<cd>
[x,y,z] = meshgrid(-1:0.5:1);

u = x;
v = y;
w = z;

quiver3(x,y,z,u,v,w)
</cd>

    </subsection>

    <subsection xml:id="double-integrals">
        <title>Double Integrals</title>

<cd>
syms x y

f = x*y;

int(int(f,y,0,1),x,0,2)
</cd>

        <p>
            Equivalent notation:
        </p>

<cd>
int(f,y,0,1)
ans = int(ans,x,0,2)
</cd>

    </subsection>

    <subsection xml:id="triple-integrals">
        <title>Triple Integrals</title>

<cd>
syms x y z

f = x+y+z;

int(int(int(f,z,0,1),y,0,1),x,0,1)
</cd>

    </subsection>

    <subsection xml:id="implicit-surfaces">
        <title>Implicit Surfaces</title>

<cd>
fimplicit3(@(x,y,z) ...
x.^2 + y.^2 + z.^2 - 4)
</cd>

        <p>
            Example: a sphere of radius 2.
        </p>

    </subsection>

    <subsection xml:id="parametric-surfaces">
        <title>Parametric Surfaces</title>

<cd>
[u,v] = meshgrid( ...
linspace(0,2*pi,50), ...
linspace(0,1,25));

x = cos(u);
y = sin(u);
z = v;

surf(x,y,z)
</cd>

    </subsection>

    <subsection xml:id="finding-critical-points">
        <title>Critical Points</title>

<cd>
syms x y

f = x^3 - 3*x*y + y^3;

fx = diff(f,x);
fy = diff(f,y);

solve([fx==0,fy==0],[x,y])
</cd>

    </subsection>

    <subsection xml:id="plotting-multiple-surfaces">
        <title>Plotting Multiple Surfaces</title>

<cd>
hold on

surf(x,y,z1)

surf(x,y,z2)

hold off
</cd>

        <p>
            Use transparency if surfaces overlap.
        </p>

<cd>
alpha(0.6)
</cd>

    </subsection>

    <subsection xml:id="useful-commands">
        <title>Useful Commands</title>

<cd>
help surf
help contour
help quiver
help plot3

clear
clc
close all
</cd>

        <ul>
            <li><c>surf</c> creates a surface plot.</li>
            <li><c>contour</c> creates level curves.</li>
            <li><c>plot3</c> plots space curves.</li>
            <li><c>quiver</c> plots vector fields.</li>
            <li><c>meshgrid</c> creates plotting grids.</li>
            <li><c>diff</c> computes symbolic derivatives.</li>
            <li><c>int</c> computes symbolic integrals.</li>
        </ul>

    </subsection>
</section>
