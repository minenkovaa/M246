<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="systems-activity">
  <title>Systems of Equations Activity</title>

  <!-- Optional introduction -->
  <introduction>

    <p>
      We are working on building up our skills in solving linear systems.
    </p>
    <tabular>
    <col width="25%"/>
    <col width="63%"/>
      <row header="yes">
        <cell><p>Activity</p></cell>
        <cell><p>Description</p></cell>
      </row>
      <row>
        <cell><p><alert>Mission Possible: Find the Solution</alert></p></cell>
        <cell><p>Analyze and solve the three systems of equations, then state whether each system has one solution, no solution, or infinitely many solutions.</p></cell></row>
    </tabular>
  </introduction>

    
<tabular>

    <col right="minor" width="30%"/>
    <col right="minor" width="30%"/>
    <col width="30%"/>

  <row header="yes">
    <cell>System 1</cell>
    <cell>System 2</cell>
    <cell>System 3</cell>
  </row>
  <row>
    <cell>
      <m>
      \left\{
      \begin{aligned}
      2x+y-z&amp;=4\\
      x+3y+2z&amp;=2\\
      10y+10z&amp;=1
      \end{aligned}
      \right.\qquad
      </m>
      <workspace lines="15"/>
    </cell>

    <cell>
      <m>\qquad
      \left\{
      \begin{aligned}
      2x+y-z&amp;=-1\\
      x+3y+2z&amp;=2\\
      x+3z&amp;=7
      \end{aligned}
      \right.\qquad
      </m>
      <workspace lines="15"/>
    </cell>

    <cell>
      <m>\qquad
      \left\{
      \begin{aligned}
      2x+y-z&amp;=0\\
      x+3y+2z&amp;=0\\
      10y+10z&amp;=0
      \end{aligned}
      \right.\qquad
      </m>
      <workspace lines="15"/>
    </cell>
  </row>
</tabular>



</worksheet>
