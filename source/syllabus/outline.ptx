<?xml version="1.0" encoding="utf-8"?>

<section xml:id="outline" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Course Outline</title>
    <introduction>
      <p>
        This page provides the weekly outline for M246, including core topics,
        learning activities, deliverables, and recommended open educational
        resources (OER).
      </p>
    </introduction>

    <subsection xml:id="weekly-outline">
      <title>Weekly Schedule</title>

      <table>
        <title>Weekly Topics, Activities, and Deliverables</title>
        <tabular>
          <col width="8%"/>
          <col width="18%"/>
          <col width="33%"/>
          <col width="25%"/>
          <row header="yes">
            <cell><p>Week</p></cell>
            <cell><p>Module</p></cell>
            <cell><p>Topics</p></cell>
            <cell><p>Activities</p></cell>
          </row>

          <row>
            <cell><p>0</p></cell>
            <cell><p>Introduction and Review</p></cell>
            <cell><p>Syllabus and Course Expectations</p></cell>
            <cell><p>Practice</p></cell>
          </row>

          <row>
            <cell><p>1</p></cell>
            <cell><p>Linear Algebra</p></cell>
            <cell><p>Matrix operations; properties</p></cell>
            <cell><p>Lecture and practice</p></cell>
          </row>
          <row>
            <cell><p>2</p></cell>
            <cell><p>Linear Algebra</p></cell>
            <cell><p>Determinants; inverses; rank</p></cell>
            <cell><p>Problem set</p></cell>
          </row>

          <row>
            <cell><p>3</p></cell>
            <cell><p>Linear Algebra</p></cell>
            <cell><p>Systems; eigenvalues and eigenvectors</p></cell>
            <cell><p>Workshop and MATLAB demo</p></cell>
          </row>

          <row>
            <cell><p>4</p></cell>
            <cell><p>Multivariable Calculus</p></cell>
            <cell><p>Partial derivatives; higher-order derivatives</p></cell>
            <cell><p>Lecture and concept check</p></cell>
          </row>

          <row>
            <cell><p>5</p></cell>
            <cell><p>Multivariable Calculus</p></cell>
            <cell><p>Multiple integrals; vector calculus</p></cell>
            <cell><p>Problem set and visualization</p></cell>
          </row>

          <row>
            <cell><p>6</p></cell>
            <cell><p>ODE</p></cell>
            <cell><p>First-order ODEs (separable, linear, exact)</p></cell>
            <cell><p>Lecture and stations</p></cell>
          </row>

          <row>
            <cell><p>7</p></cell>
            <cell><p>ODE</p></cell>
            <cell><p>Second-order linear ODEs</p></cell>
            <cell><p>Worked examples</p></cell>
          </row>

          <row>
            <cell><p>8</p></cell>
            <cell><p>ODE</p></cell>
            <cell><p>Systems; Laplace transforms; numerical introduction</p></cell>
            <cell><p>Lab demo and review</p></cell>
          </row>

          <row>
            <cell><p>9</p></cell>
            <cell><p>PDE</p></cell>
            <cell><p>Classification; physical interpretation</p></cell>
            <cell><p>Lecture and exercises</p></cell>
          </row>

          <row>
            <cell><p>10</p></cell>
            <cell><p>PDE</p></cell>
            <cell><p>Heat and wave equations</p></cell>
            <cell><p>Workshop and computational check</p></cell>
          </row>

          <row>
            <cell><p>11</p></cell>
            <cell><p>Applications</p></cell>
            <cell><p>Model formulation</p></cell>
            <cell><p>Project Proposal</p></cell>
          </row>

          <row>
            <cell><p>12</p></cell>
            <cell><p>Applications</p></cell>
            <cell><p>Analytical vs. numerical methods</p></cell>
            <cell><p>Progress Check</p></cell>
          </row>

          <row>
            <cell><p>13</p></cell>
            <cell><p>Applications</p></cell>
            <cell><p>Computational tools; visualization</p></cell>
            <cell><p>Technical Draft</p></cell>
          </row>

          <row>
            <cell><p>14</p></cell>
            <cell><p>Integration</p></cell>
            <cell><p>Comprehensive review</p></cell>
            <cell><p>Presentations; Final Report; Final Exam</p></cell>
          </row>

        </tabular>
      </table>
    </subsection>

    <subsection xml:id="readings">
      <title>Key Open Educational Resources</title>
<list xml:id="oer-list">
    <title>Recommended additional readings</title>
    <ul>
        <li>
          <em>Linear Algebra: An Interactive Introduction</em>,
          Text:
          <url href="https://ximera.osu.edu/oerlinalg/LinearAlgebra">Ximera online text</url>
        </li>
          <li>
          <em>Interactive Linear Algebra</em>,
          LibreTexts:
          <url href="https://eng.libretexts.org/Bookshelves/Applied_Mathematics/Applied_Linear_Algebra_and_Differential_Equations_(EngLib)">Interactive Linear Algebra at LibreTexts</url>
        </li>

        <li>
          <em>APEX Calculus, Volume 3</em>:
          <url href="https://www.apexcalculus.com/volume-3/">APEX Calculus, Volume 3</url>
        </li>

        <li>
          <em>Paul’s Online Notes: Differential Equations and PDEs</em>:
          <url href="https://tutorial.math.lamar.edu/Classes/DE/DE.aspx">Paul’s online differential equations notes</url>
        </li>

        <li>
          <em>Numerical Methods with Applications</em>,
          Engineering LibreTexts:
          <url href="https://eng.libretexts.org/Bookshelves/Applied_Mathematics/Numerical_Methods_with_Applications_(EngLib)">Numerical Methods at Engineering LibreTexts</url>
        </li>
        </ul>
      </list>
    </subsection>
</section>
