<?xml version="1.0" encoding="UTF-8"?>

<handout>
  <title>Determinants Activity</title>
<exercise  workspace="2in">
    <title>Find the Determinant</title>

    <p>Find the determinant of each matrix.</p>

    <ol>
        <li>
            <m>
            \begin{bmatrix}
            3 &amp; 2\\
            1 &amp; 4
            \end{bmatrix}
            </m>
        </li>
        <li>
            <m>
            \begin{bmatrix}
            5 &amp; -1\\
            2 &amp; 3
            \end{bmatrix}
            </m>
        </li>
        <li>
            <m>
            \begin{bmatrix}
            2 &amp; 6\\
            1 &amp; 3
            \end{bmatrix}
            </m>
        </li>
    </ol>

    
        <p>What does a determinant of <m>0</m> tell you about a matrix?</p>
    </exercise>

<exercise workspace="2in">
    <title>Determinant of a Product</title>

    <p>Find the determinants of the matrices below.</p>

    <p>
        <m>
        A=
        \begin{bmatrix}
        1 &amp; 2\\
        3 &amp; 4
        \end{bmatrix},
        \qquad
        B=
        \begin{bmatrix}
        2 &amp; 1\\
        5 &amp; 3
        \end{bmatrix}
        </m>
    </p>

    <ol>
        <li>Find <m>\det(A)</m>.</li>
        <li>Find <m>\det(B)</m>.</li>
        <li>Compute <m>AB</m> and find <m>\det(AB)</m>.</li>
        <li>Compare <m>\det(A)\det(B)</m> with <m>\det(AB)</m>.</li>
    </ol>
        <p>Write a rule about determinants and matrix multiplication.</p>
</exercise>

<exercise  workspace="2in">
    <title>Can You Add Determinants?</title>

    <p>Consider the matrices</p>

    <p>
        <m>
        A=
        \begin{bmatrix}
        1 &amp; 0\\
        0 &amp; 2
        \end{bmatrix},
        \qquad
        B=
        \begin{bmatrix}
        2 &amp; 0\\
        0 &amp; 1
        \end{bmatrix}
        </m>
    </p>

    <ol>
        <li>Find <m>\det(A)</m>.</li>
        <li>Find <m>\det(B)</m>.</li>
        <li>Find <m>\det(A)+\det(B)</m>.</li>
        <li>Find <m>A+B</m>.</li>
        <li>Find <m>\det(A+B)</m>.</li>
    </ol>
        <p>Is <m>\det(A+B)=\det(A)+\det(B)</m>? Explain your conclusion.</p>
</exercise>

<exercise workspace="2in">
    <title>Effect of Row Operations</title>

    <p>Let</p>

    <p>
        <m>
        A=
        \begin{bmatrix}
        2 &amp; 1\\
        4 &amp; 5
        \end{bmatrix}
        </m>
    </p>

    <ol>
        <li>Find <m>\det(A)</m>.</li>
        <li>Swap the two rows and find the new determinant.</li>
        <li>Multiply the first row by <m>3</m> and find the new determinant.</li>
    </ol>

        <p>Describe how row swaps and row scaling affect a determinant.</p>
</exercise>

<exercise workspace="2in">
    <title>Determinants of Inverses and Transposes</title>

    <p>
        Let
    </p>

    <p>
        <m>
        A=
        \begin{bmatrix}
        2 &amp; 1\\
        3 &amp; 2
        \end{bmatrix}
        </m>
    </p>

    <ol>
        <li>Find <m>\det(A)</m>.</li>
        <li>Find <m>A^{-1}</m> and then compute <m>\det(A^{-1})</m>.</li>
        <li>Compare <m>\det(A)</m> and <m>\det(A^{-1})</m>.</li>
        <li>Find the transpose <m>A^T</m>.</li>
        <li>Compute <m>\det(A^T)</m>.</li>
    </ol>

        <p>
            Based on your work, write a rule for
            <m>\det(A^{-1})</m>
            and a rule for
            <m>\det(A^T)</m>.
        </p>

</exercise>
</handout>