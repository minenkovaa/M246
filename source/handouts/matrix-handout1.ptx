<?xml version="1.0" encoding="UTF-8"?>

<handout>
  <title>Matrix Activity 1</title>

  <!-- Optional introduction -->

  <!-- Exercises start here. -->
  <exercise workspace="1in">
    <title> Matrix Addition</title>

    <p>Given</p>

    <me>
A=\begin{bmatrix} 2 &amp; 1 \\ 3 &amp; 4 \end{bmatrix}
\qquad
B=\begin{bmatrix} 5 &amp; 0 \\ 1 &amp; 2 \end{bmatrix}
    </me>

    <ol>
        <li><p>Compute <m>A+B</m>.</p></li>
        <li><p>Verify whether <m>A+B=B+A</m>.</p></li>
        <li><p>What property does this illustrate?</p></li>
        <li><p>Explain why matrices must have the same dimensions to be added.</p></li>
    </ol>
</exercise>

<exercise workspace="1in">
    <title>Matrix Subtraction</title>

    <p>Given</p>

    <me>
A=\begin{bmatrix} 7 &amp; 3 \\ 2 &amp; 8 \end{bmatrix}
\qquad
B=\begin{bmatrix} 4 &amp; 1 \\ 5 &amp; 2 \end{bmatrix}
    </me>

    <ol>
        <li><p>Find <m>A-B</m>.</p></li>
        <li><p>Find <m>B-A</m>.</p></li>
        <li><p>Compare the results.</p></li>
        <li><p>Is matrix subtraction commutative? Explain using your results.</p></li>
    </ol>
</exercise>

<exercise workspace="1in">
    <title> Scalar Multiplication</title>

    <p>Given</p>

    <me>
C=\begin{bmatrix} 2 &amp; -1 \\ 4 &amp; 3 \end{bmatrix}
    </me>

    <ol>
        <li><p>Calculate <m>3C</m>.</p></li>
        <li><p>Calculate <m>-2C</m>.</p></li>
        <li><p>Describe what happens to each matrix entry during scalar multiplication.</p></li>
        <li><p>How does scalar multiplication affect the values in a matrix?</p></li>
    </ol>
</exercise>

<exercise workspace="1in">
    <title>Identity Matrix</title>

    <p>Given</p>

    <me>
A=\begin{bmatrix} 4 &amp; 6 \\ 1 &amp; 3 \end{bmatrix}
\qquad
I=\begin{bmatrix} 1 &amp; 0 \\ 0 &amp; 1 \end{bmatrix}
    </me>

    <ol>
        <li><p>Compute <m>AI</m>.</p></li>
        <li><p>Compute <m>IA</m>.</p></li>
        <li><p>Compare each result with matrix <m>A</m>.</p></li>
        <li><p>Why is the identity matrix called the multiplicative identity?</p></li>
    </ol>
</exercise>

<exercise workspace="1in">
    <title>Zero Matrix</title>

    <p>Given</p>

    <me>
A=\begin{bmatrix} 2 &amp; 5 \\ 1 &amp; 4 \end{bmatrix}
\qquad
O=\begin{bmatrix} 0 &amp; 0 \\ 0 &amp; 0 \end{bmatrix}
    </me>

    <ol>
        <li><p>Compute <m>A+O</m>.</p></li>
        <li><p>Compute <m>A-O</m>.</p></li>
        <li><p>Compute <m>AO</m>.</p></li>
        <li><p>Compare the role of the zero in numbers and matrices.</p></li>
        </ol>
    </exercise>

</handout>
