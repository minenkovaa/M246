  </row>  <row>
    <cell><p>1</p></cell>
    <cell><p><m> \begin{bmatrix}1 &amp; 2 &amp; 0\\-1 &amp; 3 &amp; 4\\2 &amp; 1 &amp; 1 \end{bmatrix} </m> </p></cell>
    <cell><p> <m> \begin{bmatrix} 1 &amp; 2 &amp; 3\\2 &amp; 5 &amp; 8\\0 &amp; 1 &amp; 2\end{bmatrix} </m> </p></cell>
    <cell><p> <m> \begin{bmatrix} 1 &amp; 0 &amp; 2 &amp; 0\\-3 &amp; 4 &amp; 1 &amp; 0\\0 &amp; 2 &amp; -5 &amp; 1\\0 &amp; 0 &amp; 3 &amp; 1\end{bmatrix} </m> </p></cell>
