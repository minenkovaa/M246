    <exercise workspace="3in">
      <statement>
        <p>
       Use Gaussian Elimination determine whether matrices . <m>A,\ B</m> and <m>C</m> are invertible, and if they are, find their inverses.
                </p>
      </statement>
    </exercise>
 
    <exercise workspace="3in">
      <statement><p>
     Compute the determinants of <m>A,\ B,\ C</m>.                </p>
      </statement>
    </exercise>
  
    <exercise workspace="3in">
      <statement><p>
      Assume for given <m>3\times3</m> matrices <m>X, Y,</m> and <m>Z</m>: <m>\det X=2</m>, <m>\det Y=-3</m>, and <m>\det Z=0</m>. Which of <m>X,\ Y,</m> and <m>Z</m> are invertible and which are not? Why or why not?
    Then find the determinant of <m>X\cdot Y</m>, <m>X^{-1}</m>, and <m>3X\cdot Y</m>. 
    </p></statement>
    </exercise>

</worksheet>
